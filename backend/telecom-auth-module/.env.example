# Copy to .env and adjust. NEVER commit the real .env.

ENVIRONMENT=development
DEBUG=true

# Database (async driver required)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/telecom

# JWT — generate a strong secret for production, e.g.: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Password policy
PASSWORD_MIN_LENGTH=10
BCRYPT_ROUNDS=12

# Account lockout
MAX_FAILED_LOGINS=5

# CORS (JSON array)
CORS_ORIGINS=["http://localhost:4200"]
